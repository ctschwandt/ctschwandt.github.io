      "description": "Main link action, shown with its normal and hover treatments.",
      "html": "<a class=\"ds-primary\" href=\"/projects/\">View projects<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 15 15 5M5 5h10v10\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;gap:.65rem;align-items:center;justify-content:center;border-radius:8px;padding:.65rem 1rem;background:var(--accent,#c7b9f3);color:var(--sidebar,#1c1c30);text-decoration:none;font-weight:600;font-size:.875rem;line-height:1.65;min-height:42px;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-primary:hover{background:var(--accent-hover,#e3d8ff);color:var(--sidebar,#1c1c30);}.ds-primary:focus-visible{outline:2px solid var(--focus,#d2c1ff);outline-offset:5px;}@media(hover:hover) and (prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 150ms ease-out;}} :host-context([data-theme='light']) .ds-primary{color:#fff;}"
    },
    {
      "name": "Project action",
      "kind": "button",
      "refersTo": "button-project",
      "description": "The compact filled action at the foot of each showcase.",
      "html": "<a class=\"ds-project-action\" href=\"/projects/opengl-maze-fps/\">Explore project<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 15 15 5M5 5h10v10\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a>",
      "css": ".ds-project-action{display:inline-flex;gap:.6rem;align-items:center;justify-content:center;min-height:40px;padding:.55rem .9rem;border-radius:7px;background:var(--accent,#c7b9f3);color:var(--paper,#22223b);font-size:.9375rem;font-weight:600;line-height:1.65;text-decoration:none;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-project-action:hover{background:var(--ink,#f2e9e4);color:var(--paper,#22223b);}.ds-project-action:focus-visible{outline:2px solid var(--focus,#d2c1ff);outline-offset:5px;}"
    },
    {
      "name": "Quiet link",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "An unfilled secondary destination beside the main homepage action.",
      "html": "<a class=\"ds-quiet\" href=\"/experience/\">Experience<svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 15 15 5M5 5h10v10\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a>",
      "css": ".ds-quiet{display:inline-flex;gap:.45rem;align-items:center;color:var(--secondary,#bdb9ce);font-size:.875rem;line-height:1.65;text-decoration:none;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-quiet:hover{color:var(--accent,#c7b9f3);}.ds-quiet:focus-visible{outline:2px solid var(--focus,#d2c1ff);outline-offset:5px;}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
