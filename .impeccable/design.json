      "css": ".ds-technologies{display:flex;flex-wrap:wrap;gap:.45rem;list-style:none;margin:0;padding:0;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-technologies li{margin:0;padding:.25rem .6rem;border:1px solid var(--line,#4a4e69);border-radius:6px;color:var(--secondary,#bdb9ce);font-size:.75rem;line-height:1.4;}"
