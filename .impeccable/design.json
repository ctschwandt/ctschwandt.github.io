  "narrative": {
    "northStar": "Personal software exhibition",
    "overview": "A personal software exhibition pairs Cole’s visible photograph and academic profile with substantial demonstrations of his engineering work. Deep indigo grounds, lighter violet panels, warm text, and lavender interactions evolve the original Jekyll identity. Real screenshots and videos supply the visual detail; the interface gives them room beside direct technical descriptions.\n\nModern sans-serif typography, clear groups, softly rounded panels, and restrained state changes make the portfolio confident and approachable. The owner’s November 2026 redesign brief replaces the former cream/green, serif, technical-report direction. Personal identity and authentic project evidence govern the system across pages.",
    "keyCharacteristics": [
      "Indigo and lavender tonal layers with warm, readable text.",
      "Manrope headings paired with IBM Plex Sans reading text.",
      "A prominent portrait/profile and substantial project media.",
      "Clear navigation, contained panels, and concise technical labels.",
      "Native, keyboard-accessible media with restrained motion."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the existing semantic CSS properties for surfaces, text, and interactions so each component follows the selected theme. Keep original screenshot and video pixels unchanged.",
        "section": "colors"
      },
      {
        "name": "The Reading Pair Rule",
        "body": "Use Manrope for headings and IBM Plex Sans for interface and reading text. Reserve monospace for code rather than turning the portfolio into a simulated terminal.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use the established surface layers and fine borders for ordinary grouping. Keep motion tied to an existing hover or selection interaction.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic indigo, lavender, and warm-text palette across both themes.",
      "Do pair Manrope headings with IBM Plex Sans reading and interface text.",
      "Do keep the real profile portrait and personal academic identity prominent.",
      "Do give authentic project screenshots, videos, authored technical bullets, and source links substantial space.",
      "Do preserve keyboard focus, native media controls, direct-link fallbacks, and reduced-motion behavior.",
      "Do use tonal panels, rounded containment, and clear spacing to separate content groups."
    ],
    "donts": [
      "Don't restore the rejected cream/green palette or serif technical-report direction.",
      "Don't substitute stock imagery, fabricated screenshots, or simulated terminals for actual work.",
      "Don't reduce substantial project demonstrations to tiny previews and text-only rows.",
      "Don't add unsupported claims, proficiency scores, or generic marketing slogans.",
      "Don't autoplay project demonstrations or force motion on reduced-motion users."
    ]
  }
