    {
      "name": "Project card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "The reusable tonal card with an existing project name, stack, and direct route.",
      "html": "<article class=\"ds-card\"><h3><a href=\"/projects/opengl-maze-fps/\">OpenGL Maze FPS</a></h3><p>C++ · OpenGL</p><a class=\"ds-card-link\" href=\"/projects/opengl-maze-fps/\">Explore project</a></article>",
      "css": ".ds-card{overflow:hidden;border:1px solid var(--line,#4a4e69);border-radius:14px;background:var(--surface,#292940);padding:1.5rem;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-card h3{font-family:var(--display,Manrope,\"Segoe UI\",sans-serif);font-size:1.35rem;font-weight:700;line-height:1.25;letter-spacing:-.025em;margin:0 0 .85rem;}.ds-card h3 a{color:var(--ink,#f2e9e4);text-decoration:none;}.ds-card h3 a:hover{color:var(--accent,#c7b9f3);}.ds-card p{font-size:.9375rem;line-height:1.7;color:var(--secondary,#bdb9ce);margin:1rem 0 1.3rem;}.ds-card-link{color:var(--accent,#c7b9f3);font-size:.8125rem;text-decoration:none;}.ds-card-link:hover{text-decoration:underline;}.ds-card a:focus-visible{outline:2px solid var(--focus,#d2c1ff);outline-offset:5px;}"
    },
    {
      "name": "Appearance select",
      "kind": "input",
      "refersTo": "appearance-select",
      "description": "A labeled native select offers System, Light, and Dark.",
      "html": "<div class=\"ds-appearance\"><label for=\"ds-appearance-select\">Appearance</label><select id=\"ds-appearance-select\"><option>System</option><option>Light</option><option selected>Dark</option></select></div>",
      "css": ".ds-appearance{display:flex;align-items:center;gap:.6rem;color:var(--secondary,#bdb9ce);font-size:.8125rem;line-height:1.65;font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);}.ds-appearance select{font-family:var(--sans,'IBM Plex Sans','Segoe UI',sans-serif);font-size:.8125rem;padding:.4rem .5rem;background:var(--surface,#292940);color:var(--ink,#f2e9e4);border:1px solid var(--line,#4a4e69);border-radius:6px;min-height:36px;}.ds-appearance select:focus-visible{outline:2px solid var(--focus,#d2c1ff);outline-offset:5px;}"
