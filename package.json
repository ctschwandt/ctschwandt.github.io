{
  "name": "cole-schwandt-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "check:site": "tsx scripts/check-site.ts",
    "test": "npm run check:content",
    "build": "npm run typecheck && tsx scripts/build.ts && npm run check:site",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
